{UTF-8}
Reuniones con inspectores por semana=
	0.25
	~	reunión/Week
	~	Esfuerzo de campo para abrir cauces (1 reunión cada 4 semanas).
	|

Modo de contacto=
	0
	~	Dmnl
	~	0 = opt-in vía inspector (guerrilla); 1 = contacto en frío a todos los regantes.
	|

Política de alertas=
	0
	~	Dmnl
	~	0 = avisar solo cuando cambia el estado; 1 = avisar en cada imagen (zumbido).
	|

Fracción de falsas alarmas=
	0.3
	~	Dmnl
	~	Parte de las alertas que no corresponden a estrés real. 0,3 = umbrales sin calibrar; ~0,1 = calibrados en campo. Se puede tomar de Falsas alarmas / Alertas rojas emitidas en satellagro.mdl.
	|

Capacidad de reportes por semana=
	15
	~	regante/Week
	~	Reportes 'picadura' que el equipo puede entregar y explicar por semana.
	|

Semana de inicio de cobro=
	48
	~	Week
	~	Primera temporada gratis (piloto); se cobra desde oct 2027.
	|

Cauces en la zona=
	40
	~	cauce
	~	Inspecciones de Cauce con vid en Luján de Cuyo, Maipú y Valle de Uco. Supuesto: verificar con DGI.
	|

Cauces sin contactar=
	INTEG(-Apertura de cauces, Cauces en la zona)
	~	cauce
	~	
	|

Cauces aliados=
	INTEG(Apertura de cauces, 0)
	~	cauce
	~	Cauces cuyo inspector acepta difundir los reportes.
	|

Probabilidad de acuerdo base=
	0.25
	~	cauce/reunión
	~	Chance de que una reunión termine en acuerdo, sin casos para mostrar.
	|

Mejora por caso de éxito=
	0.5
	~	1/caso
	~	Cuánto sube la chance de acuerdo por cada caso publicado.
	|

Efecto de los casos=
	MIN(3, 1 + Casos de éxito publicados * Mejora por caso de éxito)
	~	Dmnl
	~	
	|

Apertura de cauces=
	MIN(Cauces sin contactar / TIME STEP, Reuniones con inspectores por semana * Probabilidad de acuerdo base * Efecto de los casos * Reputación / Reputación inicial)
	~	cauce/Week
	~	
	|

Regantes por cauce=
	120
	~	regante/cauce
	~	Supuesto: verificar padrón de un cauce real.
	|

Fracción con vid=
	0.6
	~	Dmnl
	~	Parte de los regantes del cauce con viñedo.
	|

Mercado alcanzado=
	Cauces aliados * Regantes por cauce * Fracción con vid
	~	regante
	~	
	|

Ventana estacional=
	WITH LOOKUP(Time, ([(0,0)-(78,1)],(0,0.5),(4,1),(17,1),(22,0.5),(26,0.1),(48,0.1),(52,0.5),(56,1),(69,1),(74,0.5),(78,0.3)))
	~	Dmnl
	~	El 'atardecer': 1 en dic–feb (calor, envero), 0,1 en invierno. Semana 0 = 1 nov 2026.
	|

Regantes sin conocer=
	INTEG(Incorporación de regantes - Difusión directa - Boca a boca, 0)
	~	regante
	~	
	|

Incorporación de regantes=
	Apertura de cauces * Regantes por cauce * Fracción con vid
	~	regante/Week
	~	
	|

Tasa de difusión del inspector=
	0.08
	~	1/Week
	~	Fracción de regantes del cauce que el inspector informa por semana en temporada.
	|

Tasa de contacto en frío=
	0.25
	~	1/Week
	~	En frío llegamos más rápido a todos, pero sin confianza.
	|

Difusión directa=
	Regantes sin conocer * Ventana estacional * IF THEN ELSE(Modo de contacto = 1, Tasa de contacto en frío, Tasa de difusión del inspector)
	~	regante/Week
	~	
	|

Fuerza del boca a boca=
	0.3
	~	1/Week
	~	Contactos entre vecinos de turno × probabilidad de que uno convenza al otro.
	|

Peso del boca a boca negativo=
	1.5
	~	Dmnl
	~	Un desencantado habla más que un contento.
	|

Fracción convencida neta=
	MAX(0, XIDZ(Suscriptos - Peso del boca a boca negativo * Abandonaron, Mercado alcanzado, 0))
	~	Dmnl
	~	
	|

Boca a boca=
	Regantes sin conocer * Fuerza del boca a boca * Fracción convencida neta * Ventana estacional
	~	regante/Week
	~	El vector: cada suscripto muestra el mapa al vecino.
	|

Conocen sin pedir=
	INTEG(Difusión directa + Boca a boca + Vuelven a evaluar - Pedidos de reporte, 0)
	~	regante
	~	
	|

Fracción que pide por inspector=
	0.12
	~	1/Week
	~	Recomendado por el inspector, el regante pide su reporte.
	|

Fracción que pide en frío=
	0.04
	~	1/Week
	~	Mensaje de un desconocido: pocos lo piden.
	|

Pedidos deseados=
	Conocen sin pedir * Ventana estacional * Reputación * IF THEN ELSE(Modo de contacto = 1, Fracción que pide en frío, Fracción que pide por inspector)
	~	regante/Week
	~	
	|

Pedidos de reporte=
	MIN(Pedidos deseados, Capacidad de reportes por semana)
	~	regante/Week
	~	La 'picadura': reporte gratis de 1 página.
	|

Con reporte=
	INTEG(Pedidos de reporte - Altas - Vuelven a evaluar - Descartes, 0)
	~	regante
	~	Picados: recibieron el reporte y lo están evaluando.
	|

Tiempo de evaluación=
	2
	~	Week
	~	
	|

Probabilidad base de roncha=
	0.45
	~	Dmnl
	~	Chance de que el reporte muestre algo que el productor no sabía y quiera seguir.
	|

Reputación inicial=
	0.7
	~	Dmnl
	~	
	|

Probabilidad de roncha=
	MIN(1, Probabilidad base de roncha * (0.3 + 0.7 * Ventana estacional) * Reputación / Reputación inicial)
	~	Dmnl
	~	Fuera de temporada el reporte muestra poco.
	|

Altas=
	Con reporte * Probabilidad de roncha / Tiempo de evaluación
	~	regante/Week
	~	
	|

Fracción que reintenta=
	0.5
	~	Dmnl
	~	De los no convencidos, cuántos podrían volver a pedir más adelante.
	|

Vuelven a evaluar=
	Con reporte * (1 - Probabilidad de roncha) * Fracción que reintenta / Tiempo de evaluación
	~	regante/Week
	~	
	|

Descartes=
	Con reporte * (1 - Probabilidad de roncha) * (1 - Fracción que reintenta) / Tiempo de evaluación
	~	regante/Week
	~	
	|

Descartaron=
	INTEG(Descartes, 0)
	~	regante
	~	
	|

Suscriptos=
	INTEG(Altas - Abandonos, 0)
	~	regante
	~	Reciben alertas cada 5 días en el panel.
	|

Abandonaron=
	INTEG(Abandonos, 0)
	~	regante
	~	
	|

Abandono base=
	0.005
	~	1/Week
	~	
	|

Alertas por semana=
	Ventana estacional * IF THEN ELSE(Política de alertas = 1, 1.4, 0.25)
	~	alerta/Week
	~	Por suscriptor. Cada imagen = 1,4/semana; solo cambios ≈ 0,25.
	|

Tolerancia a alertas=
	0.5
	~	alerta/Week
	~	
	|

Sensibilidad al zumbido=
	0.05
	~	1/alerta
	~	
	|

Probabilidad de abandono por falsa alarma=
	0.08
	~	1/alerta
	~	
	|

Tasa de abandono=
	Abandono base + MAX(0, Alertas por semana - Tolerancia a alertas) * Sensibilidad al zumbido + Alertas por semana * Fracción de falsas alarmas * Probabilidad de abandono por falsa alarma
	~	1/Week
	~	
	|

Abandonos=
	Suscriptos * Tasa de abandono
	~	regante/Week
	~	Nos aplastaron.
	|

Reputación=
	INTEG(Cambio de reputación, Reputación inicial)
	~	Dmnl
	~	Confianza en SatellAgro dentro de los cauces (0–1).
	|

Cambio de reputación=
	(Reputación objetivo - Reputación) / Tiempo de formación de reputación
	~	1/Week
	~	
	|

Tiempo de formación de reputación=
	6
	~	Week
	~	
	|

Aporte de los casos=
	MIN(0.3, Casos de éxito publicados * 0.05)
	~	Dmnl
	~	
	|

Peso de las falsas alarmas=
	0.8
	~	Dmnl
	~	
	|

Penalización por falsas alarmas=
	Peso de las falsas alarmas * Fracción de falsas alarmas * MIN(1, Suscriptos / 10)
	~	Dmnl
	~	Se nota cuando hay usuarios expuestos.
	|

Penalización por contacto en frío=
	0.25 * Modo de contacto
	~	Dmnl
	~	
	|

Penalización por abandonos=
	0.5 * XIDZ(Abandonaron, Mercado alcanzado, 0)
	~	Dmnl
	~	
	|

Reputación objetivo=
	MAX(0.05, MIN(1, Reputación inicial + Aporte de los casos - Penalización por falsas alarmas - Penalización por contacto en frío - Penalización por abandonos))
	~	Dmnl
	~	
	|

Fracción documentable=
	0.1
	~	caso/regante
	~	Suscriptos que al cierre aceptan ser caso con números.
	|

Cierre de temporada=
	PULSE(22, 1) + PULSE(74, 1)
	~	Dmnl
	~	Fin de marzo de cada temporada.
	|

Nuevos casos=
	Suscriptos * Fracción documentable * (1 - Fracción de falsas alarmas) * Cierre de temporada / Duración del cierre
	~	caso/Week
	~	
	|

Duración del cierre=
	1
	~	Week
	~	
	|

Casos de éxito publicados=
	INTEG(Nuevos casos, 0)
	~	caso
	~	
	|

Precio por temporada=
	150
	~	USD/regante
	~	Supuesto de precio por productor y temporada.
	|

Semanas de temporada=
	26
	~	Week
	~	
	|

Ingresos semanales=
	IF THEN ELSE(Time >= Semana de inicio de cobro, Suscriptos * Precio por temporada / Semanas de temporada, 0)
	~	USD/Week
	~	
	|

Costo por reporte=
	15
	~	USD/regante
	~	Tiempo de explicar el reporte (visita o llamada).
	|

Costo por reunión=
	40
	~	USD/reunión
	~	Viaje y tiempo.
	|

Costo fijo semanal=
	50
	~	USD/Week
	~	Servicios y mantenimiento (supuesto).
	|

Costos semanales=
	Pedidos de reporte * Costo por reporte + Reuniones con inspectores por semana * Costo por reunión + Costo fijo semanal
	~	USD/Week
	~	
	|

Ingresos acumulados=
	INTEG(Ingresos semanales, 0)
	~	USD
	~	
	|

Costos acumulados=
	INTEG(Costos semanales, 0)
	~	USD
	~	
	|

Resultado acumulado=
	Ingresos acumulados - Costos acumulados
	~	USD
	~	
	|

Altas acumuladas=
	INTEG(Altas registradas, 0)
	~	regante
	~	
	|

Altas registradas=
	Altas
	~	regante/Week
	~	
	|

Costo por alta=
	XIDZ(Costos acumulados, Altas acumuladas, 0)
	~	USD/regante
	~	
	|

Retención=
	XIDZ(Suscriptos, Altas acumuladas, 0)
	~	Dmnl
	~	
	|

********************************************************
	.Control
********************************************************~
		Dos temporadas de vid en Mendoza: semana 0 = 1 nov 2026, semana 78 = fin de abril 2028.
	|

FINAL TIME  = 78
	~	Week
	~	Fin de la segunda temporada.
	|

INITIAL TIME  = 0
	~	Week
	~	1 de noviembre de 2026.
	|

SAVEPER  = 1
	~	Week [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP  = 0.25
	~	Week [0,?]
	~	Paso de integración.
	|

